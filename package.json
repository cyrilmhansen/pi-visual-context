{
  "name": "pi-visual-context",
  "version": "0.1.0",
  "private": true,
  "description": "Pi extension for dense multimodal visual source context",
  "keywords": ["pi-package"],
  "files": ["src", "typst", "tools/rust-strip-lex/Cargo.toml", "tools/rust-strip-lex/Cargo.lock", "tools/rust-strip-lex/src", "tools/c-strip-lex/Cargo.toml", "tools/c-strip-lex/Cargo.lock", "tools/c-strip-lex/src", "assets/fonts/romulus/Romulus.ttf", "THIRD_PARTY_NOTICES.md", "scripts", "README.md", "LICENSE", "package.json"],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build:rust": "bash scripts/build-rust.sh",
    "build:c": "cargo build --release --manifest-path tools/c-strip-lex/Cargo.toml",
    "release:check": "bash scripts/release.sh"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  }
}
